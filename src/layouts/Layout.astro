---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import ToastProvider from "@/components/ui/ToastProvider";

interface Props {
  title?: string;
}

const { title = "Dog Tricks Tracker" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script>
      // On bfcache restoration (back/forward), immediately hide the page and
      // force a fresh server request. location.replace() is more reliable than
      // reload() for bfcache in Chrome/Safari.
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) {
          document.body.style.setProperty("visibility", "hidden", "important");
          location.replace(location.href);
        }
      });
    </script>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <ToastProvider client:only="react" />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
