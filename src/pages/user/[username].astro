---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { calculateProgressScore } from "@/lib/calculate-score";

// Extract username from URL
const username = Astro.params.username;

if (!username) {
  return Astro.redirect("/404", 404);
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

// Fetch profile by username
const { data: profile } = await supabase
  .from("profiles")
  .select("*")
  .eq("login_name", username)
  .single();

if (!profile) {
  return Astro.redirect("/404", 404);
}

// Calculate age
const dob = new Date(profile.date_of_birth);
const today = new Date();
let age = today.getFullYear() - dob.getFullYear();
const monthDiff = today.getMonth() - dob.getMonth();
if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
  age--;
}

// Calculate progress score
const score = await calculateProgressScore(supabase, profile.user_id);

// Fetch user's trick progress
const { data: userTricks } = await supabase
  .from("user_tricks")
  .select("trick_id, status, tricks(*)")
  .eq("user_id", profile.user_id);

// Group tricks by status
const favorites = userTricks?.filter((ut) => ut.status === "favorite") || [];
const inProgress = userTricks?.filter((ut) => ut.status === "in-progress") || [];
const finished = userTricks?.filter((ut) => ut.status === "finished") || [];
---

<Layout title={`${profile.dog_name}'s Profile`}>
  <div class="bg-cosmic min-h-screen p-4 pt-20">
    <div class="mx-auto max-w-2xl">
      <h1
        class="mb-8 bg-gradient-to-r from-purple-300 via-blue-200 to-purple-300 bg-clip-text text-4xl font-bold text-transparent"
      >
        {profile.dog_name}'s Profile
      </h1>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-md">
        <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start">
          <div class="flex-shrink-0">
            {
              profile.photo_url ? (
                <img
                  src={profile.photo_url}
                  alt={profile.dog_name}
                  class="size-32 rounded-full border-2 border-white/20 object-cover"
                />
              ) : (
                <div class="flex size-32 items-center justify-center rounded-full border-2 border-white/20 bg-white/10 text-4xl">
                  🐕
                </div>
              )
            }
          </div>

          <div class="flex-grow text-center sm:text-left">
            <h2 class="text-3xl font-bold text-blue-100">{profile.dog_name}</h2>
            <p class="text-sm text-blue-100/70">@{profile.login_name}</p>

            <div class="mt-4 space-y-2 text-sm">
              <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
                <span class="font-medium text-blue-100">Breed:</span>
                <span class="text-blue-100/80">{profile.breed}</span>
              </div>
              <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
                <span class="font-medium text-blue-100">Age:</span>
                <span class="text-blue-100/80">{age} year{age !== 1 ? "s" : ""} old</span>
              </div>
              <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
                <span class="font-medium text-blue-100">Sex:</span>
                <span class="text-blue-100/80">{profile.sex}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 border-t border-white/10 pt-6">
          <div class="text-center">
            <div class="text-5xl font-bold text-purple-300">{score}</div>
            <div class="text-sm text-blue-100/80">training points</div>
          </div>
        </div>

        <!-- Tricks grouped by status -->
        <div class="mt-8 space-y-6">
          <!-- Favorites -->
          {
            favorites.length > 0 && (
              <div>
                <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-blue-100">
                  <span>⭐</span>
                  <span>Favorites</span>
                </h3>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                  {favorites.map((ut) => (
                    <a
                      href={`/tricks/${ut.tricks?.slug}`}
                      class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-blue-100 transition-colors hover:bg-white/10"
                    >
                      {ut.tricks?.name}
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <!-- In Progress -->
          {
            inProgress.length > 0 && (
              <div>
                <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-blue-100">
                  <span>🕒</span>
                  <span>In Progress</span>
                </h3>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                  {inProgress.map((ut) => (
                    <a
                      href={`/tricks/${ut.tricks?.slug}`}
                      class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-blue-100 transition-colors hover:bg-white/10"
                    >
                      {ut.tricks?.name}
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <!-- Finished -->
          {
            finished.length > 0 && (
              <div>
                <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-blue-100">
                  <span>✅</span>
                  <span>Finished</span>
                </h3>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                  {finished.map((ut) => (
                    <a
                      href={`/tricks/${ut.tricks?.slug}`}
                      class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-blue-100 transition-colors hover:bg-white/10"
                    >
                      {ut.tricks?.name}
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          {
            favorites.length === 0 && inProgress.length === 0 && finished.length === 0 && (
              <div class="py-8 text-center">
                <p class="text-blue-100/60">No tricks tracked yet</p>
              </div>
            )
          }
        </div>

        <div class="mt-6">
          <a
            href="/dashboard"
            class="block w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-center text-sm text-blue-100 transition-colors hover:bg-white/20"
          >
            ← Back to Dashboard
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
