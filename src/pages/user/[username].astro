---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { calculateProgressScore } from "@/lib/calculate-score";
import ProfileDisplay from "@/components/profile/ProfileDisplay.astro";

// Extract username from URL
const username = Astro.params.username;

if (!username) {
  return Astro.redirect("/404", 404);
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

// Fetch profile by username
const { data: profile } = await supabase.from("profiles").select("*").eq("login_name", username).single();

if (!profile) {
  return Astro.redirect("/404", 404);
}

// Get current user (may be null if not authenticated)
const currentUser = Astro.locals.user;

// Check if current user follows this profile
let isFollowing = false;
if (currentUser && currentUser.id !== profile.user_id) {
  const { data: followRow } = await supabase
    .from("follows")
    .select("*")
    .eq("follower_id", currentUser.id)
    .eq("following_id", profile.user_id)
    .maybeSingle();

  isFollowing = !!followRow;
}

// Calculate age
const dob = new Date(profile.date_of_birth);
const today = new Date();
let age = today.getFullYear() - dob.getFullYear();
const monthDiff = today.getMonth() - dob.getMonth();
if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
  age--;
}

// Calculate progress score
const score = await calculateProgressScore(supabase, profile.user_id);

// Fetch user's trick progress
const { data: userTricks } = await supabase
  .from("user_tricks")
  .select("trick_id, status, tricks(*)")
  .eq("user_id", profile.user_id);

// Group tricks by status
const favorites = userTricks?.filter((ut) => ut.status === "favorite") ?? [];
const inProgress = userTricks?.filter((ut) => ut.status === "in-progress") ?? [];
const finished = userTricks?.filter((ut) => ut.status === "finished") ?? [];
---

<Layout title={`${profile.dog_name}'s Profile`}>
  <div class="bg-cosmic min-h-screen p-4 pt-20">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <h1
        class="mb-8 bg-gradient-to-r from-purple-300 via-blue-200 to-purple-300 bg-clip-text text-4xl font-bold text-transparent"
      >
        {profile.dog_name}'s Profile
      </h1>

      <ProfileDisplay
        profile={profile}
        age={age}
        score={score}
        favorites={favorites}
        inProgress={inProgress}
        finished={finished}
        isOwnProfile={currentUser?.id === profile.user_id}
        currentUserId={currentUser?.id}
        isFollowing={isFollowing}
        currentPath={Astro.url.pathname}
      />
    </div>
  </div>
</Layout>
