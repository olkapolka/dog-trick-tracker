---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import TrickCard from "@/components/catalog/TrickCard.astro";
import TrainingPoints from "@/components/catalog/TrainingPoints";
import { calculateProgressScoreResult } from "@/lib/calculate-score";
import type { Tables, Enums } from "@/lib/database.types";
import { resolveDashboardState } from "@/lib/page-state-contracts";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase) {
  return Astro.redirect("/auth/signin");
}

// Check if user has profile and fetch full profile data
const { data: profile } = await supabase.from("profiles").select("*").eq("user_id", user.id).single();

if (!profile) {
  return Astro.redirect("/profile/create");
}

// Calculate progress score
const scoreResult = await calculateProgressScoreResult(supabase, user.id);
const score = scoreResult.ok ? scoreResult.score : 0;

// Fetch tricks for catalog with user status
const { data: tricksData, error: tricksError } = await supabase
  .from("tricks")
  .select(
    `
    *,
    user_tricks!left(status)
  `,
  )
  .eq("user_tricks.user_id", user.id)
  .order("name");

// Transform the data to include userStatus
type TrickWithStatus = Tables<"tricks"> & {
  user_tricks?: { status: Enums<"trick_status"> }[];
};

const tricks = (tricksData as TrickWithStatus[] | null)?.map((t) => ({
  ...t,
  userStatus: t.user_tricks?.[0]?.status ?? null,
}));

const pageState = resolveDashboardState({
  // Profile fetch failures redirect to /profile/create above, so this branch cannot reach page-state resolution.
  profileError: false,
  scoreError: !scoreResult.ok,
  catalogError: tricksError !== null,
  catalogCount: tricks?.length ?? 0,
});

const beginner = tricks?.filter((t) => t.difficulty === "beginner") ?? [];
const intermediate = tricks?.filter((t) => t.difficulty === "intermediate") ?? [];
const advanced = tricks?.filter((t) => t.difficulty === "advanced") ?? [];
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4 pt-20">
    <div class="mx-auto max-w-7xl">
      <Topbar />

      <div class="mb-8">
        <div class="mb-6 flex items-center justify-between">
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-4xl font-bold text-transparent">
            Trick Catalog
          </h1>
          <a
            href="/profile"
            class="group flex items-center gap-3 rounded-lg border border-white/20 bg-white/10 px-4 py-2 transition-colors hover:bg-white/20"
          >
            {
              profile.photo_url ? (
                <img
                  src={profile.photo_url}
                  alt={profile.dog_name}
                  class="size-8 rounded-full object-cover ring-2 ring-purple-400/30"
                />
              ) : (
                <div class="flex size-8 items-center justify-center rounded-full bg-gradient-to-br from-purple-400 to-blue-400 text-xs font-bold text-white ring-2 ring-purple-400/30">
                  {profile.dog_name.charAt(0)}
                </div>
              )
            }
            <div class="flex flex-col items-start">
              <span class="text-xs text-blue-100/60">Training Points</span>
              <TrainingPoints initialScore={score} client:only="react" />
            </div>
          </a>
        </div>
        <p class="text-blue-100/80">Browse tricks and start training with your dog</p>
      </div>

      {
        pageState === "error" ? (
          <div class="rounded-2xl border border-rose-300/30 bg-rose-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-rose-100">Unable to load your dashboard right now. Please refresh and try again.</p>
          </div>
        ) : tricks && tricks.length > 0 ? (
          <div class="space-y-10">
            {/* Beginner Section */}
            {beginner.length > 0 && (
              <section>
                <h2 class="mb-4 text-2xl font-semibold text-white">⭐ Beginner</h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
                  {beginner.map((trick) => (
                    <TrickCard trick={trick} userStatus={trick.userStatus} />
                  ))}
                </div>
              </section>
            )}

            {/* Intermediate Section */}
            {intermediate.length > 0 && (
              <section>
                <h2 class="mb-4 text-2xl font-semibold text-white">⭐⭐ Intermediate</h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
                  {intermediate.map((trick) => (
                    <TrickCard trick={trick} userStatus={trick.userStatus} />
                  ))}
                </div>
              </section>
            )}

            {/* Advanced Section */}
            {advanced.length > 0 && (
              <section>
                <h2 class="mb-4 text-2xl font-semibold text-white">⭐⭐⭐ Advanced</h2>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
                  {advanced.map((trick) => (
                    <TrickCard trick={trick} userStatus={trick.userStatus} />
                  ))}
                </div>
              </section>
            )}
          </div>
        ) : (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-blue-100/80">No tricks in catalog yet. Check back soon!</p>
          </div>
        )
      }
    </div>
  </div>
</Layout>
