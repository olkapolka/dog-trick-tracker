---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const { slug } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase) {
  return Astro.redirect("/auth/signin");
}

const { data: trick, error } = await supabase
  .from("tricks")
  .select("*")
  .eq("slug", slug)
  .single();

if (error || !trick) {
  return Astro.redirect("/404", 404);
}

// Generate difficulty badge based on difficulty level
const difficultyBadges = {
  beginner: "⭐",
  intermediate: "⭐⭐",
  advanced: "⭐⭐⭐",
} as const;

const badge = difficultyBadges[trick.difficulty];

// Format description with step-by-step structure preserved
// Replace \n with <br> tags for proper line breaks
const formattedDescription = trick.description.split("\n").filter((line) => line.trim());
---

<Layout title={`${trick.name} - Trick Detail`}>
  <div class="bg-cosmic min-h-screen p-6">
    <div class="mx-auto max-w-4xl">
      {/* Breadcrumb */}
      <div class="mb-6">
        <a
          href="/dashboard"
          class="inline-flex items-center text-blue-200 transition-colors hover:text-purple-200"
        >
          <svg
            class="mr-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Catalog
        </a>
      </div>

      {/* Trick Detail Card */}
      <div class="rounded-2xl border border-white/10 bg-white/10 p-8 backdrop-blur-xl">
        {/* Header */}
        <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-4xl font-bold text-transparent">
            {trick.name}
          </h1>
          <span class="text-3xl" aria-label={`Difficulty: ${trick.difficulty}`}>
            {badge}
          </span>
        </div>

        {/* Difficulty Label */}
        <div class="mb-6">
          <span class="inline-block rounded-full bg-white/20 px-4 py-1 text-sm font-medium capitalize text-blue-100">
            {trick.difficulty}
          </span>
        </div>

        {/* Teaching Instructions */}
        <div class="space-y-3 text-white">
          <h2 class="mb-4 text-xl font-semibold text-blue-200">Teaching Instructions</h2>
          <div class="space-y-2 text-blue-100/90">
            {
              formattedDescription.map((line) => (
                <p class="leading-relaxed">{line}</p>
              ))
            }
          </div>
        </div>

        {/* Placeholder for Status Toggle (Phase 6) */}
        <div class="mt-8 border-t border-white/10 pt-6">
          <p class="text-sm text-blue-100/60">
            Status tracking will be available in the next phase
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
