---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { calculateProgressScoreResult } from "@/lib/calculate-score";
import { resolveProfileState } from "@/lib/page-state-contracts";
import ProfileDisplay from "@/components/profile/ProfileDisplay.astro";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return Astro.redirect("/auth/signin");
}

const { data: profile } = await supabase.from("profiles").select("*").eq("user_id", user.id).single();

if (!profile) {
  return Astro.redirect("/profile/create");
}

// Calculate age
const dob = new Date(profile.date_of_birth);
const today = new Date();
let age = today.getFullYear() - dob.getFullYear();
const monthDiff = today.getMonth() - dob.getMonth();
if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
  age--;
}

// Calculate progress score
const scoreResult = await calculateProgressScoreResult(supabase, user.id);
const score = scoreResult.ok ? scoreResult.score : 0;

// Fetch user's trick progress
const { data: userTricks, error: userTricksError } = await supabase
  .from("user_tricks")
  .select("trick_id, status, tricks(*)")
  .eq("user_id", user.id);

const pageState = resolveProfileState({
  profileError: false,
  scoreError: !scoreResult.ok,
  userTricksError: userTricksError !== null,
  trickCount: userTricks?.length ?? 0,
});

// Group tricks by status
const favorites = userTricks?.filter((ut) => ut.status === "favorite") ?? [];
const inProgress = userTricks?.filter((ut) => ut.status === "in-progress") ?? [];
const finished = userTricks?.filter((ut) => ut.status === "finished") ?? [];
---

<Layout title="My Profile">
  <div class="bg-cosmic min-h-screen p-4 pt-20">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <h1
        class="mb-8 bg-gradient-to-r from-purple-300 via-blue-200 to-purple-300 bg-clip-text text-4xl font-bold text-transparent"
      >
        My Profile
      </h1>

      {
        pageState === "error" ? (
          <div class="rounded-2xl border border-rose-300/30 bg-rose-500/10 p-8 text-center text-white backdrop-blur-xl">
            <p class="text-rose-100">Unable to load your profile details right now. Please refresh and try again.</p>
          </div>
        ) : (
          <ProfileDisplay
            profile={profile}
            age={age}
            score={score}
            favorites={favorites}
            inProgress={inProgress}
            finished={finished}
            isOwnProfile={true}
            currentUserId={user.id}
            isFollowing={false}
            currentPath={Astro.url.pathname}
          />
        )
      }
    </div>
  </div>
</Layout>
