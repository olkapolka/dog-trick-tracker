---
import Layout from "@/layouts/Layout.astro";
import { DOG_BREEDS } from "@/lib/breeds";
import { createClient } from "@/lib/supabase";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return Astro.redirect("/auth/signin");
}

// Check if user already has profile
const { data: existingProfile } = await supabase.from("profiles").select("id").eq("user_id", user.id).single();

if (existingProfile) {
  return Astro.redirect("/dashboard");
}

const url = new URL(Astro.request.url);
const serverError = url.searchParams.get("error");
---

<Layout title="Create Your Profile">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <h1
          class="bg-gradient-to-r from-purple-300 via-blue-200 to-purple-300 bg-clip-text text-4xl font-bold text-transparent"
        >
          Create Your Profile
        </h1>
        <p class="mt-2 text-sm text-blue-100/70">Tell us about your furry friend to get started</p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-md">
        <form method="POST" action="/api/profile/create" class="space-y-4" novalidate>
          <div>
            <label for="login_name" class="mb-1 block text-sm text-blue-100/80">Username</label>
            <input
              id="login_name"
              name="login_name"
              type="text"
              required
              placeholder="my-awesome-dog"
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/40"
            />
          </div>

          <div>
            <label for="dog_name" class="mb-1 block text-sm text-blue-100/80">Dog name</label>
            <input
              id="dog_name"
              name="dog_name"
              type="text"
              required
              placeholder="Max"
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/40"
            />
          </div>

          <div>
            <label for="breed" class="mb-1 block text-sm text-blue-100/80">Breed</label>
            <select
              id="breed"
              name="breed"
              required
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white"
            >
              <option value="" class="bg-slate-800 text-white">Select a breed</option>
              {
                DOG_BREEDS.map((breed) => (
                  <option value={breed} class="bg-slate-800 text-white">
                    {breed}
                  </option>
                ))
              }
            </select>
          </div>

          <div>
            <label for="date_of_birth" class="mb-1 block text-sm text-blue-100/80">Date of birth</label>
            <input
              id="date_of_birth"
              name="date_of_birth"
              type="date"
              required
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white"
            />
          </div>

          <fieldset>
            <legend class="mb-1 block text-sm text-blue-100/80">Sex</legend>
            <div class="flex gap-4 text-sm text-blue-100/80">
              <label class="inline-flex items-center gap-2">
                <input type="radio" name="sex" value="Male" required />
                Male
              </label>
              <label class="inline-flex items-center gap-2">
                <input type="radio" name="sex" value="Female" required />
                Female
              </label>
            </div>
          </fieldset>

          {
            serverError ? (
              <p class="rounded-lg border border-red-300/40 bg-red-400/15 p-3 text-sm text-red-100">{serverError}</p>
            ) : null
          }

          <button
            type="submit"
            class="w-full rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
          >
            Create profile
          </button>
        </form>
      </div>

      <p class="mt-4 text-center text-xs text-blue-100/50">Note: Usernames cannot be changed after creation</p>
    </div>
  </div>
</Layout>
