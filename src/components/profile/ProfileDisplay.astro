---
import { PhotoUpload } from "./PhotoUpload";
import ShareModal from "./ShareModal";
import { FollowButton } from "./FollowButton";
import type { Database } from "@/lib/database.types";

type ProfileRow = Database["public"]["Tables"]["profiles"]["Row"];

interface Props {
  profile: ProfileRow;
  age: number;
  score: number;
  favorites: { tricks: { name: string; slug: string } }[];
  inProgress: { tricks: { name: string; slug: string } }[];
  finished: { tricks: { name: string; slug: string } }[];
  isOwnProfile?: boolean;
  currentUserId?: string | null;
  isFollowing?: boolean;
  currentPath?: string;
}

const {
  profile,
  age,
  score,
  favorites,
  inProgress,
  finished,
  isOwnProfile = false,
  currentUserId = null,
  isFollowing = false,
  currentPath = "",
} = Astro.props;
---

<div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-md">
  <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start">
    <div class="flex-shrink-0">
      {
        isOwnProfile ? (
          <PhotoUpload value={profile.photo_url} client:only="react" />
        ) : profile.photo_url ? (
          <img
            src={profile.photo_url}
            alt={profile.dog_name}
            class="size-32 rounded-full border-2 border-white/20 object-cover"
          />
        ) : (
          <div class="flex size-32 items-center justify-center rounded-full border-2 border-white/20 bg-white/10 text-4xl">
            🐕
          </div>
        )
      }
    </div>

    <div class="flex-grow text-center sm:text-left">
      <h2 class="text-3xl font-bold text-blue-100">{profile.dog_name}</h2>
      <p class="text-sm text-blue-100/70">@{profile.login_name}</p>

      <div class="mt-4 space-y-2 text-sm">
        <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
          <span class="font-medium text-blue-100">Breed:</span>
          <span class="text-blue-100/80">{profile.breed}</span>
        </div>
        <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
          <span class="font-medium text-blue-100">Age:</span>
          <span class="text-blue-100/80">{age} year{age !== 1 ? "s" : ""} old</span>
        </div>
        <div class="flex flex-col gap-1 sm:flex-row sm:gap-2">
          <span class="font-medium text-blue-100">Sex:</span>
          <span class="text-blue-100/80">{profile.sex}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-8 border-t border-white/10 pt-6">
    <div class="text-center">
      <div class="text-5xl font-bold text-purple-300">{score}</div>
      <div class="text-sm text-blue-100/80">training points</div>
      {isOwnProfile && <p class="mt-2 text-xs text-blue-100/50">Mark tricks as finished to earn points!</p>}
    </div>
  </div>

  <!-- Tricks grouped by status -->
  <div class="mt-8 space-y-6">
    <!-- Favorites -->
    {
      favorites.length > 0 && (
        <div>
          <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-blue-100">
            <span>⭐</span>
            <span>Favorites</span>
          </h3>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {favorites.map((ut) => (
              <a
                href={`/tricks/${ut.tricks.slug}`}
                class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-blue-100 transition-colors hover:bg-white/10"
              >
                {ut.tricks.name}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- In Progress -->
    {
      inProgress.length > 0 && (
        <div>
          <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-blue-100">
            <span>🕒</span>
            <span>In Progress</span>
          </h3>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {inProgress.map((ut) => (
              <a
                href={`/tricks/${ut.tricks.slug}`}
                class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-blue-100 transition-colors hover:bg-white/10"
              >
                {ut.tricks.name}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Finished -->
    {
      finished.length > 0 && (
        <div>
          <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold text-blue-100">
            <span>✅</span>
            <span>Finished</span>
          </h3>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {finished.map((ut) => (
              <a
                href={`/tricks/${ut.tricks.slug}`}
                class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-blue-100 transition-colors hover:bg-white/10"
              >
                {ut.tricks.name}
              </a>
            ))}
          </div>
        </div>
      )
    }

    {
      favorites.length === 0 && inProgress.length === 0 && finished.length === 0 && (
        <div class="py-8 text-center">
          <p class="text-blue-100/60">No tricks tracked yet</p>
          {isOwnProfile && (
            <a href="/dashboard" class="mt-2 inline-block text-sm text-purple-300 hover:text-purple-200">
              Browse the catalog →
            </a>
          )}
        </div>
      )
    }
  </div>

  <div class="mt-6">
    {
      isOwnProfile ? (
        <ShareModal
          profileUrl={`${Astro.url.origin}/user/${profile.login_name}`}
          username={profile.login_name}
          client:only="react"
        />
      ) : (
        <FollowButton
          followingId={profile.user_id}
          initialIsFollowing={isFollowing}
          isAuthenticated={!!currentUserId}
          currentPath={currentPath}
          client:only="react"
        />
      )
    }
  </div>
</div>
