---
import type { Tables, Enums } from "@/lib/database.types";
import StatusToggle from "@/components/catalog/StatusToggle";

interface Props {
  trick: Tables<"tricks">;
  userStatus?: Enums<"trick_status"> | null;
}

const { trick, userStatus = null } = Astro.props;

// Generate difficulty badge based on difficulty level
const difficultyBadges = {
  beginner: "⭐",
  intermediate: "⭐⭐",
  advanced: "⭐⭐⭐",
} as const;

const badge = difficultyBadges[trick.difficulty];

// Truncate description to ~100 chars
const truncatedDescription =
  trick.description.length > 100 ? trick.description.substring(0, 100).trim() + "..." : trick.description;
---

<div class="relative block rounded-xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
  <a href={`/tricks/${trick.slug}`} class="group">
    <div class="mb-3 flex items-center justify-between">
      <h3 class="text-xl font-semibold text-white group-hover:text-purple-200">
        {trick.name}
      </h3>
      <span class="text-xl" aria-label={`Difficulty: ${trick.difficulty}`}>
        {badge}
      </span>
    </div>
    <p class="mb-4 text-sm text-blue-100/70">
      {truncatedDescription}
    </p>
  </a>
  <div class="relative">
    <StatusToggle trickId={trick.id} initialStatus={userStatus} client:load />
  </div>
</div>
