---
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let isAdmin = false;

if (user && supabase) {
  const { data: profile } = await supabase.from("profiles").select("is_admin").eq("user_id", user.id).maybeSingle();
  isAdmin = profile?.is_admin === true;
}
---

<div
  class="mb-4 flex flex-col gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80 sm:flex-row sm:items-center sm:justify-between sm:gap-0"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/dashboard" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Dashboard
          </a>
          <a href="/profile" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Profile
          </a>
          <a href="/friends" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Friends
          </a>
          {isAdmin ? (
            <a href="/admin/tricks" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Admin
            </a>
          ) : null}
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Sign out
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex flex-wrap gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign up
          </a>
        </div>
      </>
    )
  }
</div>
