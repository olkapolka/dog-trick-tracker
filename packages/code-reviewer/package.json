  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "2.9.1",
    "ai": "6.0.209",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "promptfoo": "0.121.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
