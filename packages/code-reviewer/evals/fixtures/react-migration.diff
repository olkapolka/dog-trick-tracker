+interface UserCardState {
+  isLoading: boolean;
+  error: string | null;
+  followersCount: number;
+}
+
+export class UserCard extends Component<UserCardProps, UserCardState> {
+  state: UserCardState = {
+    isLoading: false,
+    error: null,
+    followersCount: 0,
+  };
+
+  async componentDidMount() {
+    const { userId } = this.props;
+    this.setState({ isLoading: true });
+    try {
+      const res = await fetch(`/api/users/${userId}/followers`);
+      if (!res.ok) throw new Error(`HTTP ${res.status}`);
+      const data = await res.json();
+      this.setState({ followersCount: data.count, isLoading: false });
+    } catch (err) {
+      this.setState({
+        error: err instanceof Error ? err.message : 'Unknown error',
+        isLoading: false,
+      });
+    }
+  }
+
+  handleClick = () => {
+    const { userId, onCardClick } = this.props;
+    if (onCardClick) {
+      onCardClick(userId);
+    }
+  };
+
+  render() {
+    const { name, avatarUrl, badges = [] } = this.props;
+    const { isLoading, error, followersCount } = this.state;
+
+    return (
+      <div className="user-card" onClick={this.handleClick}>
+        <h2 ref="cardTitle" className="user-card__name">{name}</h2>
+        <img src={avatarUrl} alt={name} className="user-card__avatar" />
+        {isLoading && <span className="user-card__loading">Loading…</span>}
+        {error && <span className="user-card__error">{error}</span>}
+        {!isLoading && !error && (
+          <span className="user-card__followers">{followersCount} followers</span>
+        )}
+        {badges.length > 0 && (
+          <ul className="user-card__badges">
+            {badges.map((badge) => (
+              <li className="badge" style={{ color: badge.color }}>
+                {badge.label}
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    );
+  }
+}

 export default UserCard;
